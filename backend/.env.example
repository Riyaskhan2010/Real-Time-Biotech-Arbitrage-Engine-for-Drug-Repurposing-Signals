# Backend environment variables
# Copy this file to .env and fill in values

# Application
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./bioarbitrage.db

# AI Service (optional - app works without this)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Ingestion sources
NCBI_API_KEY=                          # optional — raises PubMed rate limit 3→10 req/s
ELSEVIER_API_KEY=                      # required for Elsevier/ScienceDirect — never expose to frontend
INGESTION_MAX_RECORDS_PER_SOURCE=20
INGESTION_REQUEST_TIMEOUT=15
INGESTION_ENABLED_SOURCES=pubmed,biorxiv,medrxiv,clinicaltrials,elsevier
INGESTION_QUERY_TERMS=drug repurposing,metformin alzheimer,rapamycin aging,sildenafil neurodegeneration
