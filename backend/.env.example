# Backend environment variables
# Copy this file to .env and fill in values for local development.
# For Render production deployment, set these in the Render Dashboard → Environment.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
# Local development: SQLite file next to main.py
DATABASE_URL=sqlite:///./bioarbitrage.db
# Render production (set via render.yaml / Render Dashboard):
# DATABASE_URL=sqlite:////data/bioarbitrage.db

# ── AI Service (optional — app works without this) ────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production (set to your Render frontend URL):
# ALLOWED_ORIGINS=https://your-frontend.onrender.com

# ── Ingestion Sources ─────────────────────────────────────────────────────────
# PubMed NCBI API key — optional, raises rate limit from 3→10 req/s
# Get a free key at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Elsevier/Scopus API key — required for Elsevier source
# Get a key at https://dev.elsevier.com/
# NEVER expose this key in frontend code or logs
ELSEVIER_API_KEY=

# Max records fetched per source per query term (increase for more coverage)
INGESTION_MAX_RECORDS_PER_SOURCE=50

# HTTP timeout per individual API request (seconds)
INGESTION_REQUEST_TIMEOUT=20

# Enabled sources (comma-separated)
INGESTION_ENABLED_SOURCES=pubmed,biorxiv,medrxiv,clinicaltrials,elsevier,europepmc,uniprot

# Default background query terms (comma-separated)
INGESTION_QUERY_TERMS=drug repurposing,metformin alzheimer,rapamycin aging,sildenafil neurodegeneration,aspirin alzheimer,metformin cancer,sildenafil pulmonary hypertension
